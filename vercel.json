{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pp",
      "destination": "/pp.html"
    },
    {
      "source": "/privacy",
      "destination": "/pp.html"
    },
    {
      "source": "/tos",
      "destination": "/tos.html"
    },
    {
      "source": "/terms",
      "destination": "/tos.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/docs",
      "destination": "/guide.html"
    },
    {
      "source": "/invite",
      "destination": "/invite.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth_code",
      "destination": "/api/auth_code.py"
    },
    {
      "source": "/api/bot/guilds",
      "destination": "/api/bot/guilds.py"
    },
    {
      "source": "/api/bot/check_guild",
      "destination": "/api/bot/check_guild.py"
    },
    {
      "source": "/api/bot_guilds",
      "destination": "/api/bot_guilds.py"
    },
    {
      "source": "/api/bot_check_guild",
      "destination": "/api/bot_check_guild.py"
    },
    {
      "source": "/api/channels",
      "destination": "/api/channels.py"
    },
    {
      "source": "/api/roles",
      "destination": "/api/roles.py"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings.py"
    },
    {
      "source": "/api/settings/(.*)",
      "destination": "/api/settings.py"
    },
    {
      "source": "/api/test_notify",
      "destination": "/api/test_notify.py"
    },
    {
      "source": "/api/test_notify/(.*)",
      "destination": "/api/test_notify.py"
    },
    {
      "source": "/api/platforms",
      "destination": "/api/platforms.py"
    },
    {
      "source": "/api/status",
      "destination": "/api/status.py"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/metrics.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/status",
      "schedule": "*/4 * * * *"
    }
  ]
}