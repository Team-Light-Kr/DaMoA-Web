# Neon PostgreSQL Database (필수)
NEON_DB_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=1558397761861451806
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Discord Redirect URI (도메인 + /auth/callback)
DISCORD_REDIRECT_URI=https://damoa.teamlight.pe.kr/auth/callback

# Discord Bot Token (채널/역할 조회를 위해 필요)
DISCORD_TOKEN=your_discord_bot_token_here

# Flask Secret Key
FLASK_SECRET_KEY=damoa-secret-key-change-in-prod
